theme_override_fonts/font = ExtResource("6_4ppmf")
theme_override_font_sizes/font_size = 31
text = "Solve Puzzles
   Complete riddles, decoding challenges, and mini-games to unlock new memories."

[node name="Objectives3" type="Label" parent="AboutContent/ScrollContainer/AboutVBox" unique_id=375014246]
layout_mode = 2
