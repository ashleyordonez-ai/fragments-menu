[node name="AboutTitle" type="Label" parent="AboutContent/ScrollContainer/AboutVBox" unique_id=2053699928]
layout_mode = 2
theme_override_colors/font_color = Color(0.90588236, 0.7411765, 0.4117647, 1)
theme_override_fonts/font = ExtResource("6_4ppmf")
theme_override_font_sizes/font_size = 40
text = "ABOUT FRAGMENTS"
horizontal_alignment = 1
vertical_alignment = 1

[node name="AboutDescription1" type="Label" parent="AboutContent/ScrollContainer/AboutVBox" unique_id=1060351834]
layout_mode = 2
theme_override_colors/font_color = Color(0.84705883, 0.8156863, 0.9098039, 1)
theme_override_fonts/font = ExtResource("6_4ppmf")
theme_override_font_sizes/font_size = 31
text = "FRAGMENTS is a story-driven puzzle and adventure game that takes players through a journey of memories, emotions, and self-discovery. Through riddles, puzzles, and mini-games, players uncover fragments of the main character's past and gradually understand the experiences behind them."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="AboutDescription2" type="Label" parent="AboutContent/ScrollContainer/AboutVBox" unique_id=1264055996]
layout_mode = 2
theme_override_colors/font_color = Color(0.84705883, 0.8156863, 0.9098039, 1)
theme_override_fonts/font = ExtResource("6_4ppmf")
theme_override_font_sizes/font_size = 31
text = "The game is inspired by Sustainable Development Goal 3 (SDG 3): Good Health and Well-being, which promotes healthy lives and mental well-being for everyone. By exploring themes of emotional struggles, personal experiences, and self-understanding, FRAGMENTS aims to raise awareness about the importance of mental health, especially among young people."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

