theme_override_font_sizes/font_size = 31
text = "Explore and Discover
   Uncover fragments of the main character's memories by progressing through the story."

[node name="Objectives2" type="Label" parent="AboutContent/ScrollContainer/AboutVBox" unique_id=20960968]
layout_mode = 2
