[sub_resource type="GDScript" id="GDScript_2k86a"]
script/source = "extends Control

# ==========================================
# NODE REFERENCES
# ==========================================

@onready var background = $background

# Main panels
@onready var paper = $paper
@onready var frame = $frame
@onready var wood_panel = $wood_panel
@onready var riddle_label = $wood_panel/RiddleLabel

# Final word label
@onready var final_word_label = $FinalWordLabel

# Instruction popup
@onready var instruction_panel = $InstructionPanel
@onready var title_label = $InstructionPanel/TitleLabel
@onready var instruction_label = $InstructionPanel/InstructionLabel
@onready var continue_button = $InstructionPanel/ContinueButton

# Instructions button
@onready var instruction_button = $InstructionButton
@onready var instruction_button_text = $InstructionButton/ButtonText

# All seven flowers
@onready var flowers = [
	$lily,
	$edelweiss1,
	$orchid1,
	$narcicuss,
	$orchid2,
	$rose,
	$edelweiss2
]

# Seven flower slots
@onready var slots = [
	$frame/Slot1,
	$frame/Slot2,
	$frame/Slot3,
	$frame/Slot4,
	$frame/Slot5,
	$frame/Slot6,
	$frame/Slot7
]

var game_started = false
var button_tween: Tween

# DIM OVERLAY
var dim_overlay: ColorRect

# WOODEN PANEL GLOW
var wood_glow_tween: Tween
var wood_original_modulate: Color

# FRAME TRAVELING GLOW
var frame_travel_line: Line2D
var frame_glow_line: Line2D
var frame_core_line: Line2D
var frame_light_active = false
var frame_light_progress = 0.0

# RIDDLE SYSTEM
var current_riddle = 0

var riddles = [
	\"I'm often found in white, with big petals that bloom like a trumpet. I am also a popular flower in gardens. Who am I?\",
	\"I am a tiny white flower that looks like a star. I grow high up in cold mountains. Who am I?\",
	\"I come in many colors and have petals that look like butterfly wings. I am often used as decoration. Who am I?\",
	\"I have a small trumpet in the middle of my flower. I am usually yellow and bloom in spring. Who am I?\",
	\"I am a beautiful flower with unusual petals. Some of my kind look like little dancing ladies. Who am I?\",
	\"I am a flower often given on Valentine's Day. I have soft petals and sharp thorns. Who am I?\",
	\"I am a mountain flower with white, fuzzy petals. My name is also associated with the snowy Alps. Who am I?\"
]

# FLOWER HOVER AND DRAG
var flower_scales = {}
var flower_tweens = {}
var dragging_flower: Control
var drag_offset = Vector2.ZERO

# FLOWER PLACEMENT
var flower_original_positions = {}
var flower_letters = {}
var flower_name_labels = {}
var slot_letter_labels = []

var is_advancing = false

# TRUE WHEN THE PLAYER REOPENS INSTRUCTIONS DURING GAMEPLAY
var is_instruction_replay = false


# ==========================================
# READY
# ==========================================


func _ready():

	# Hide/show elements immediately before the first frame is rendered.
	background.visible = true

	paper.visible = false
	frame.visible = false
	wood_panel.visible = false

	final_word_label.visible = false

	# Hide Instructions button until the game is ready
	instruction_button.visible = false

	for flower in flowers:
		flower.visible = false

	instruction_panel.visible = false
	title_label.visible = false
	instruction_label.visible = false

	riddle_label.visible = false

	riddle_label.add_theme_color_override(
		\"font_color\",
		Color(\"#F7E7C6\")
	)

	wood_original_modulate = wood_panel.modulate

	create_dim_overlay()

	setup_continue_button()
	setup_instruction_button()

	setup_flower_interactions()
	setup_flower_slots()

	await play_intro()



# ==========================================
# CREATE DIM OVERLAY
# ==========================================

func create_dim_overlay():

	dim_overlay = ColorRect.new()
	dim_overlay.name = \"DimOverlay\"

	dim_overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)

	dim_overlay.color = Color(0, 0, 0, 0.0)

	dim_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	dim_overlay.z_index = 10

	add_child(dim_overlay)

	move_child(dim_overlay, instruction_panel.get_index())

	instruction_panel.z_index = 12

	dim_overlay.visible = false


# ==========================================
# INTRO ANIMATION
# ==========================================

func play_intro():

	await pop_in_fixed(paper, 0.55)

	await get_tree().create_timer(0.2).timeout

	for flower in flowers:

		await pop_in(
			flower,
			Vector2(0, 25),
			0.35
		)

		await get_tree().create_timer(0.12).timeout

	await get_tree().create_timer(0.3).timeout

	frame.visible = true
	frame.modulate.a = 0.0

	var frame_tween = create_tween()

	frame_tween.tween_property(
		frame,
		\"modulate:a\",
		1.0,
		0.55
	)

	await frame_tween.finished

	await get_tree().create_timer(0.2).timeout

	await pop_in(
		wood_panel,
		Vector2(0, -45),
		0.45
	)

	await get_tree().create_timer(0.4).timeout

	dim_overlay.visible = true

	var dim_tween = create_tween()

	dim_tween.tween_property(
		dim_overlay,
		\"color:a\",
		0.65,
		0.4
	)

	await dim_tween.finished

	await pop_in(
		instruction_panel,
		Vector2(0, 35),
		0.5
	)

	await get_tree().create_timer(0.2).timeout

	await pop_in_fixed(
		title_label,
		0.35
	)

	await get_tree().create_timer(0.2).timeout

	await pop_in_fixed(
		instruction_label,
		0.4
	)


# ==========================================
# POP-IN ANIMATION
# ==========================================

func pop_in(node: Control, start_offset: Vector2, duration: float):

	node.visible = true

	node.pivot_offset = node.size / 2

	var original_position = node.position
	var original_scale = node.scale
	var original_modulate = node.modulate

	node.position = original_position + start_offset
	node.scale = original_scale * 0.75

	node.modulate = Color(
		original_modulate.r,
		original_modulate.g,
		original_modulate.b,
		0.0
	)

	var tween = create_tween()
	tween.set_parallel(true)

	tween.tween_property(
		node,
		\"modulate\",
		original_modulate,
		duration
	)

	tween.tween_property(
		node,
		\"scale\",
		original_scale,
		duration
	).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

	tween.tween_property(
		node,
		\"position\",
		original_position,
		duration
	).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

	await tween.finished


# ==========================================
# FIXED POSITION POP-IN
# ==========================================

func pop_in_fixed(node: Control, duration: float):

	node.visible = true

	node.pivot_offset = node.size / 2

	var original_scale = node.scale
	var original_modulate = node.modulate

	node.scale = original_scale * 0.75

	node.modulate = Color(
		original_modulate.r,
		original_modulate.g,
		original_modulate.b,
		0.0
	)

	var tween = create_tween()
	tween.set_parallel(true)

	tween.tween_property(
		node,
		\"modulate\",
		original_modulate,
		duration
	)

	tween.tween_property(
		node,
		\"scale\",
		original_scale,
		duration
	).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

	await tween.finished


# ==========================================
# RIDDLE DISPLAY
# ==========================================

func show_current_riddle():

	if current_riddle >= riddles.size():
		return

	riddle_label.text = riddles[current_riddle]
	riddle_label.visible = true

	await pop_in_fixed(
		riddle_label,
		0.4
	)


# ==========================================
# WOODEN PANEL GLOW EFFECT
# ==========================================

func start_wood_glow():

	if wood_glow_tween and wood_glow_tween.is_running():
		wood_glow_tween.kill()

	wood_original_modulate = wood_panel.modulate

	var glow_color = Color(
		1.15,
		1.08,
		0.85,
		wood_original_modulate.a
	)

	wood_glow_tween = create_tween()
	wood_glow_tween.set_loops()

	wood_glow_tween.tween_property(
		wood_panel,
		\"modulate\",
		glow_color,
		0.6
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

	wood_glow_tween.tween_property(
		wood_panel,
		\"modulate\",
		wood_original_modulate,
		0.6
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)


func stop_wood_glow():

	if wood_glow_tween and wood_glow_tween.is_running():
		wood_glow_tween.kill()

	wood_panel.modulate = wood_original_modulate


# ==========================================
# FRAME TRAVELING GOLDEN GLOW
# ==========================================

func start_frame_traveling_glow():

	frame_light_active = true
	frame_light_progress = 0.0

	# WIDEST SOFT GOLDEN HALO
	frame_glow_line = Line2D.new()
	frame_glow_line.name = \"FrameOuterGlow\"
	frame_glow_line.width = 24.0
	frame_glow_line.antialiased = true
	frame_glow_line.z_index = 12

	# BRIGHT GOLDEN TRAIL
	frame_travel_line = Line2D.new()
	frame_travel_line.name = \"FrameTravelingLight\"
	frame_travel_line.width = 10.0
	frame_travel_line.antialiased = true
	frame_travel_line.z_index = 13

	# THIN WHITE-GOLD CORE
	frame_core_line = Line2D.new()
	frame_core_line.name = \"FrameLightCore\"
	frame_core_line.width = 4.0
	frame_core_line.antialiased = true
	frame_core_line.z_index = 14

	# OUTER HALO GRADIENT
	var outer_gradient = Gradient.new()

	outer_gradient.set_color(
		0,
		Color(1.0, 0.45, 0.05, 0.0)
	)

	outer_gradient.set_color(
		1,
		Color(1.0, 0.45, 0.05, 0.0)
	)

	outer_gradient.add_point(
		0.5,
		Color(1.0, 0.55, 0.12, 0.65)
	)

	# MIDDLE GOLDEN GLOW GRADIENT
	var middle_gradient = Gradient.new()

	middle_gradient.set_color(
		0,
		Color(1.0, 0.55, 0.1, 0.0)
	)

	middle_gradient.set_color(
		1,
		Color(1.0, 0.55, 0.1, 0.0)
	)

	middle_gradient.add_point(
		0.5,
		Color(1.0, 0.78, 0.25, 0.95)
	)

	# BRIGHT INNER CORE GRADIENT
	var core_gradient = Gradient.new()

	core_gradient.set_color(
		0,
		Color(1.0, 0.8, 0.35, 0.0)
	)

	core_gradient.set_color(
		1,
		Color(1.0, 0.8, 0.35, 0.0)
	)

	core_gradient.add_point(
		0.5,
		Color(1.0, 0.98, 0.78, 1.0)
	)

	frame_glow_line.gradient = outer_gradient
	frame_travel_line.gradient = middle_gradient
	frame_core_line.gradient = core_gradient

	add_child(frame_glow_line)
	add_child(frame_travel_line)
	add_child(frame_core_line)

	frame_glow_line.z_as_relative = true
	frame_travel_line.z_as_relative = true
	frame_core_line.z_as_relative = true

	update_frame_traveling_glow()


func update_frame_traveling_glow():

	if not frame_light_active:
		return

	if not is_instance_valid(frame):
		return

	if not is_instance_valid(frame_travel_line):
		return

	if not is_instance_valid(frame_glow_line):
		return

	if not is_instance_valid(frame_core_line):
		return

	var frame_rect = frame.get_global_rect()

	# Keep the traveling light very close to the frame border.
	var inset = 2.0

	# Convert the frame's global canvas coordinates
	# into FrameGamePlay's local coordinate space.
	var root_transform = get_global_transform_with_canvas().affine_inverse()

	var top_left = root_transform * (
		frame_rect.position + Vector2(inset, inset)
	)

	var top_right = root_transform * (
		frame_rect.position + Vector2(frame_rect.size.x - inset, inset)
	)

	var bottom_right = root_transform * (
		frame_rect.position + frame_rect.size - Vector2(inset, inset)
	)

	var bottom_left = root_transform * (
		frame_rect.position + Vector2(inset, frame_rect.size.y - inset)
	)

	var perimeter_width = top_right.x - top_left.x
	var perimeter_height = bottom_left.y - top_left.y

	var perimeter = (perimeter_width + perimeter_height) * 2.0

	if perimeter <= 0.0:
		return

	# The light occupies a short section of the border.
	var trail_length = 0.18

	var glow_points = PackedVector2Array()
	var light_points = PackedVector2Array()
	var core_points = PackedVector2Array()

	var sample_count = 40

	for i in range(sample_count + 1):

		var sample_offset = float(i) / float(sample_count)

		var path_progress = fposmod(
			frame_light_progress + sample_offset * trail_length,
			1.0
		)

		var point = get_frame_perimeter_point(
			path_progress,
			top_left,
			top_right,
			bottom_right,
			bottom_left,
			perimeter_width,
			perimeter_height,
			perimeter
		)

		glow_points.append(point)
		light_points.append(point)
		core_points.append(point)

	frame_glow_line.points = glow_points
	frame_travel_line.points = light_points
	frame_core_line.points = core_points


func get_frame_perimeter_point(
	progress: float,
	top_left: Vector2,
	top_right: Vector2,
	bottom_right: Vector2,
	bottom_left: Vector2,
	perimeter_width: float,
	perimeter_height: float,
	perimeter: float
) -> Vector2:

	var distance = progress * perimeter

	# Top edge
	if distance <= perimeter_width:
		return top_left.lerp(
			top_right,
			distance / perimeter_width
		)

	distance -= perimeter_width

	# Right edge
	if distance <= perimeter_height:
		return top_right.lerp(
			bottom_right,
			distance / perimeter_height
		)

	distance -= perimeter_height

	# Bottom edge
	if distance <= perimeter_width:
		return bottom_right.lerp(
			bottom_left,
			distance / perimeter_width
		)

	distance -= perimeter_width

	# Left edge
	return bottom_left.lerp(
		top_left,
		distance / perimeter_height
	)


func stop_frame_traveling_glow():

	frame_light_active = false

	if is_instance_valid(frame_core_line):
		frame_core_line.queue_free()

	if is_instance_valid(frame_travel_line):
		frame_travel_line.queue_free()

	if is_instance_valid(frame_glow_line):
		frame_glow_line.queue_free()

	frame_core_line = null
	frame_travel_line = null
	frame_glow_line = null


func _process(delta):

	if not frame_light_active:
		return

	# One complete lap takes approximately 5.5 seconds.
	frame_light_progress = fposmod(
		frame_light_progress + delta * 0.18,
		1.0
	)

	update_frame_traveling_glow()


# ==========================================
# FLOWER INTERACTIONS SETUP
# ==========================================

func setup_flower_interactions():

	var letters = [
		\"L\",
		\"E\",
		\"O\",
		\"N\",
		\"O\",
		\"R\",
		\"E\"
	]

	for i in range(flowers.size()):

		var flower = flowers[i]

		flower_scales[flower] = flower.scale

		flower_original_positions[flower] = flower.global_position

		flower_letters[flower] = letters[i]

		flower.mouse_filter = Control.MOUSE_FILTER_STOP

		for child in flower.get_children():

			if child is Label:
				flower_name_labels[flower] = child

			set_child_mouse_ignore(child)

		flower.mouse_entered.connect(
			_on_flower_hover.bind(flower)
		)

		flower.mouse_exited.connect(
			_on_flower_exit.bind(flower)
		)

		flower.gui_input.connect(
			_on_flower_gui_input.bind(flower)
		)


# ==========================================
# SETUP FLOWER SLOTS
# ==========================================

func setup_flower_slots():

	var letters = [
		\"L\",
		\"E\",
		\"O\",
		\"N\",
		\"O\",
		\"R\",
		\"E\"
	]

	slot_letter_labels.clear()

	for i in range(slots.size()):

		var slot = slots[i]

		slot.mouse_filter = Control.MOUSE_FILTER_IGNORE

		var letter_label = Label.new()

		letter_label.name = \"LetterLabel\"
		letter_label.text = letters[i]

		letter_label.position = slot.position
		letter_label.size = slot.size

		letter_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		letter_label.vertical_alignment = VERTICAL_ALIGNMENT_BOTTOM

		letter_label.add_theme_color_override(
			\"font_color\",
			Color(\"#F7E7C6\")
		)

		letter_label.add_theme_color_override(
			\"font_outline_color\",
			Color(\"#3C3025\")
		)

		letter_label.add_theme_constant_override(
			\"outline_size\",
			3
		)

		letter_label.add_theme_font_size_override(
			\"font_size\",
			22
		)

		letter_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
		letter_label.visible = false

		frame.add_child(letter_label)

		letter_label.z_index = 20

		slot_letter_labels.append(letter_label)


# ==========================================
# CHILD LABEL MOUSE FILTER
# ==========================================

func set_child_mouse_ignore(node: Node):

	if node is Control:
		node.mouse_filter = Control.MOUSE_FILTER_IGNORE

	for child in node.get_children():
		set_child_mouse_ignore(child)


# ==========================================
# FLOWER HOVER EFFECT
# ==========================================

func _on_flower_hover(flower: Control):

	if not game_started:
		return

	if dragging_flower == flower:
		return

	if flower_tweens.has(flower):
		if flower_tweens[flower].is_running():
			flower_tweens[flower].kill()

	var original_scale = flower_scales[flower]

	var hover_tween = create_tween()

	flower_tweens[flower] = hover_tween

	hover_tween.set_parallel(true)

	hover_tween.tween_property(
		flower,
		\"scale\",
		original_scale * 1.1,
		0.15
	).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

	hover_tween.tween_property(
		flower,
		\"modulate\",
		Color(1.15, 1.15, 1.15, 1.0),
		0.15
	)


func _on_flower_exit(flower: Control):

	if dragging_flower == flower:
		return

	if flower_tweens.has(flower):
		if flower_tweens[flower].is_running():
			flower_tweens[flower].kill()

	var original_scale = flower_scales[flower]

	var exit_tween = create_tween()

	flower_tweens[flower] = exit_tween

	exit_tween.set_parallel(true)

	exit_tween.tween_property(
		flower,
		\"scale\",
		original_scale,
		0.15
	)

	exit_tween.tween_property(
		flower,
		\"modulate\",
		Color.WHITE,
		0.15
	)


# ==========================================
# FLOWER DRAGGING
# ==========================================

func _on_flower_gui_input(event: InputEvent, flower: Control):

	if not game_started:
		return

	if event is InputEventMouseButton:

		if event.button_index == MOUSE_BUTTON_LEFT:

			if event.pressed:

				dragging_flower = flower

				drag_offset = (
					flower.global_position -
					get_global_mouse_position()
				)

				if flower_tweens.has(flower):
					if flower_tweens[flower].is_running():
						flower_tweens[flower].kill()

				flower.scale = flower_scales[flower] * 1.05


# ==========================================
# UPDATE DRAGGED FLOWER POSITION
# ==========================================

func _input(event: InputEvent):

	if dragging_flower == null:
		return

	if event is InputEventMouseMotion:

		dragging_flower.global_position = (
			get_global_mouse_position() +
			drag_offset
		)

	elif event is InputEventMouseButton:

		if event.button_index == MOUSE_BUTTON_LEFT and not event.pressed:

			var dropped_flower = dragging_flower

			dragging_flower = null

			handle_flower_drop(dropped_flower)


# ==========================================
# HANDLE FLOWER DROP
# ==========================================

func handle_flower_drop(flower: Control):

	if flower == null:
		return

	flower.scale = flower_scales[flower]

	if not game_started or is_advancing:
		return_flower(flower)
		return

	var mouse_position = get_global_mouse_position()

	var board_rect = get_board_drop_rect()

	if not board_rect.has_point(mouse_position):
		return_flower(flower)
		return

	var required_letter = [
		\"L\",
		\"E\",
		\"O\",
		\"N\",
		\"O\",
		\"R\",
		\"E\"
	][current_riddle]

	if flower_letters[flower] != required_letter:
		return_flower(flower)
		return

	lock_flower_in_slot(
		flower,
		slots[current_riddle],
		current_riddle
	)


# ==========================================
# GREEN BOARD DROP AREA
# ==========================================

func get_board_drop_rect() -> Rect2:

	var board_rect = slots[0].get_global_rect()

	for slot in slots:

		board_rect = board_rect.merge(
			slot.get_global_rect()
		)

	var margin = max(
		slots[0].size.x,
		slots[0].size.y
	) * 0.5

	return board_rect.grow(margin)


# ==========================================
# RETURN INCORRECT FLOWER
# ==========================================

func return_flower(flower: Control):

	if flower_tweens.has(flower):
		if flower_tweens[flower].is_running():
			flower_tweens[flower].kill()

	var return_tween = create_tween()

	return_tween.set_parallel(true)

	return_tween.tween_property(
		flower,
		\"global_position\",
		flower_original_positions[flower],
		0.3
	).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

	return_tween.tween_property(
		flower,
		\"scale\",
		flower_scales[flower],
		0.3
	).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

	return_tween.tween_property(
		flower,
		\"modulate\",
		Color.WHITE,
		0.3
	)


# ==========================================
# LOCK CORRECT FLOWER IN SLOT
# ==========================================

func lock_flower_in_slot(
	flower: Control,
	slot: Control,
	slot_index: int
):

	is_advancing = true
	game_started = false

	if flower_name_labels.has(flower):
		flower_name_labels[flower].visible = false

	flower.scale = flower_scales[flower]

	var slot_center = (
		slot.global_position +
		slot.size / 2
	)

	var displayed_size = flower.size * flower.scale

	flower.global_position = (
		slot_center -
		displayed_size / 2
	)

	slot_letter_labels[slot_index].visible = true

	flower.mouse_filter = Control.MOUSE_FILTER_IGNORE

	flower.modulate = Color.WHITE

	print(\"Correct flower placed! Letter revealed: \", flower_letters[flower])

	current_riddle += 1

	await get_tree().create_timer(0.4).timeout

	if current_riddle < riddles.size():

		await show_current_riddle()

		game_started = true
		is_advancing = false

	else:

		riddle_label.text = \"You did it! You spelled LEONORE!\"

		await pop_in_fixed(
			riddle_label,
			0.4
		)

		print(\"Puzzle completed! LEONORE!\")

		await play_completion_animation()

		game_started = false
		is_advancing = false


# ==========================================
# FINAL COMPLETION ANIMATION
# ==========================================

func play_completion_animation():

	await get_tree().create_timer(1.5).timeout

	stop_wood_glow()

	frame.z_index = 11

	for flower in flowers:
		flower.z_index = 11

	final_word_label.z_index = 11

	dim_overlay.visible = true
	dim_overlay.color = Color(0, 0, 0, 0.0)

	var ending_tween = create_tween()
	ending_tween.set_parallel(true)

	ending_tween.tween_property(
		dim_overlay,
		\"color:a\",
		0.65,
		0.7
	)

	ending_tween.tween_property(
		wood_panel,
		\"modulate:a\",
		0.0,
		0.7
	)

	ending_tween.tween_property(
		paper,
		\"modulate:a\",
		0.0,
		0.7
	)

	ending_tween.tween_property(
		paper,
		\"scale\",
		paper.scale * 0.9,
		0.7
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)

	ending_tween.tween_property(
		instruction_button,
		\"modulate:a\",
		0.0,
		0.7
	)

	await ending_tween.finished

	wood_panel.visible = false
	paper.visible = false
	instruction_button.visible = false

	# START THE TRAVELING FRAME GLOW WHILE THE LETTERS APPEAR
	start_frame_traveling_glow()

	for letter_label in slot_letter_labels:

		letter_label.pivot_offset = letter_label.size / 2

		var original_scale = letter_label.scale

		var glow_tween = create_tween()
		glow_tween.set_parallel(true)

		glow_tween.tween_property(
			letter_label,
			\"modulate\",
			Color(2.0, 1.7, 0.9, 1.0),
			0.35
		)

		glow_tween.tween_property(
			letter_label,
			\"scale\",
			original_scale * 1.2,
			0.2
		).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

		await glow_tween.finished

		var settle_tween = create_tween()

		settle_tween.tween_property(
			letter_label,
			\"scale\",
			original_scale,
			0.2
		).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)

		await settle_tween.finished

		await get_tree().create_timer(0.2).timeout

	final_word_label.text = \"LEONORE\"
	final_word_label.visible = true

	await pop_in_fixed(
		final_word_label,
		0.7
	)

	# FAST GOLDEN PULSE GLOW ON THE FINAL WORD
	var word_glow_tween = create_tween()
	word_glow_tween.set_loops(2)
	word_glow_tween.set_parallel(true)

	word_glow_tween.tween_property(
		final_word_label,
		\"modulate\",
		Color(2.5, 2.1, 1.2, 1.0),
		0.18
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

	word_glow_tween.tween_property(
		final_word_label,
		\"scale\",
		Vector2(1.12, 1.12),
		0.18
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)

	word_glow_tween.chain().tween_property(
		final_word_label,
		\"modulate\",
		Color.WHITE,
		0.18
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

	word_glow_tween.parallel().tween_property(
		final_word_label,
		\"scale\",
		Vector2.ONE,
		0.18
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

	await word_glow_tween.finished

	# QUICK FADE OUT OF LEONORE
	var word_fade_tween = create_tween()
	word_fade_tween.set_parallel(true)

	word_fade_tween.tween_property(
		final_word_label,
		\"modulate:a\",
		0.0,
		0.12
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)

	word_fade_tween.tween_property(
		final_word_label,
		\"scale\",
		Vector2(0.85, 0.85),
		0.12
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)

	await word_fade_tween.finished

	# STOP THE FRAME LIGHT BEFORE THE FINAL SCREEN FADE
	stop_frame_traveling_glow()

	# FADE THE ENTIRE SCREEN INTO WARM GOLD
	var gold_overlay = ColorRect.new()
	gold_overlay.name = \"GoldFadeOverlay\"
	gold_overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	gold_overlay.color = Color(1.0, 0.82, 0.48, 0.0)
	gold_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE
	gold_overlay.z_index = 100
	add_child(gold_overlay)

	var gold_bloom_tween = create_tween()
	gold_bloom_tween.tween_property(
		gold_overlay,
		\"color:a\",
		0.35,
		0.8
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

	await gold_bloom_tween.finished

	await get_tree().create_timer(0.35).timeout

	var gold_fade_tween = create_tween()
	gold_fade_tween.tween_property(
		gold_overlay,
		\"color:a\",
		1.0,
		0.2
	).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

	await gold_fade_tween.finished

	print(\"Final word displayed: LEONORE!\")


# ==========================================
# INSTRUCTIONS BUTTON SETUP
# ==========================================

func setup_instruction_button():

	instruction_button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND

	instruction_button.pivot_offset = instruction_button.size / 2

	instruction_button_text.mouse_filter = Control.MOUSE_FILTER_IGNORE

	instruction_button.z_index = 0

	instruction_button.mouse_entered.connect(
		_on_instruction_button_hover
	)

	instruction_button.mouse_exited.connect(
		_on_instruction_button_exit
	)

	# CONNECT BUTTON CLICK
	instruction_button.pressed.connect(
		_on_instruction_button_pressed
	)


# ==========================================
# INSTRUCTIONS BUTTON CLICK ACTION
# ==========================================

func _on_instruction_button_pressed():

	# Do not open if the game is not ready
	if not game_started:
		return

	if is_advancing:
		return

	if is_instruction_replay:
		return

	# Stop gameplay interactions temporarily
	game_started = false

	is_instruction_replay = true

	# Reset Continue button appearance
	continue_button.disabled = false
	continue_button.scale = Vector2.ONE
	continue_button.modulate = Color.WHITE

	# Show instruction popup
	instruction_panel.visible = true
	title_label.visible = true
	instruction_label.visible = true

	# Reset popup appearance
	instruction_panel.modulate = Color.WHITE
	instruction_panel.scale = Vector2.ONE

	title_label.modulate = Color.WHITE
	instruction_label.modulate = Color.WHITE

	# Show dim overlay and block clicks behind popup
	dim_overlay.visible = true
	dim_overlay.mouse_filter = Control.MOUSE_FILTER_STOP

	# Dim the scene
	var open_tween = create_tween()

	open_tween.tween_property(
		dim_overlay,
		\"color:a\",
		0.65,
		0.3
	)

	# Popup appears above the overlay
	instruction_panel.z_index = 12

	print(\"Instructions reopened!\")


# ==========================================
# INSTRUCTIONS BUTTON HOVER EFFECT
# ==========================================

func _on_instruction_button_hover():

	if not instruction_button.visible:
		return

	if button_tween and button_tween.is_running():
		button_tween.kill()

	button_tween = create_tween()
	button_tween.set_parallel(true)

	button_tween.tween_property(
		instruction_button,
		\"scale\",
		Vector2(1.08, 1.08),
		0.15
	).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

	button_tween.tween_property(
		instruction_button,
		\"modulate\",
		Color(1.2, 1.2, 1.2, 1.0),
		0.15
	)


func _on_instruction_button_exit():

	if button_tween and button_tween.is_running():
		button_tween.kill()

	button_tween = create_tween()
	button_tween.set_parallel(true)

	button_tween.tween_property(
		instruction_button,
		\"scale\",
		Vector2.ONE,
		0.15
	).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

	button_tween.tween_property(
		instruction_button,
		\"modulate\",
		Color.WHITE,
		0.15
	)


# ==========================================
# CONTINUE BUTTON SETUP
# ==========================================

func setup_continue_button():

	continue_button.text = \"CONTINUE\"

	continue_button.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND

	continue_button.pivot_offset = continue_button.size / 2

	continue_button.add_theme_stylebox_override(
		\"normal\",
		create_button_style(
			Color(\"#765039\"),
			Color(\"#B78B60\")
		)
	)

	continue_button.add_theme_stylebox_override(
		\"hover\",
		create_button_style(
			Color(\"#617A58\"),
			Color(\"#A9B98B\")
		)
	)

	continue_button.add_theme_stylebox_override(
		\"pressed\",
		create_button_style(
			Color(\"#465D42\"),
			Color(\"#A9B98B\")
		)
	)

	continue_button.add_theme_color_override(
		\"font_color\",
		Color(\"#FFF1D9\")
	)

	continue_button.add_theme_color_override(
		\"font_hover_color\",
		Color.WHITE
	)

	continue_button.add_theme_color_override(
		\"font_pressed_color\",
		Color.WHITE
	)

	continue_button.mouse_entered.connect(_on_button_hover)
	continue_button.mouse_exited.connect(_on_button_exit)
	continue_button.pressed.connect(_on_continue_pressed)


# ==========================================
# BUTTON STYLE
# ==========================================

func create_button_style(bg_color: Color, border_color: Color):

	var style = StyleBoxFlat.new()

	style.bg_color = bg_color
	style.border_color = border_color

	style.set_border_width_all(2)
	style.set_corner_radius_all(7)

	style.content_margin_left = 20
	style.content_margin_right = 20
	style.content_margin_top = 8
	style.content_margin_bottom = 8

	return style


# ==========================================
# CONTINUE BUTTON HOVER EFFECT
# ==========================================

func _on_button_hover():

	if button_tween and button_tween.is_running():
		button_tween.kill()

	button_tween = create_tween()

	button_tween.tween_property(
		continue_button,
		\"scale\",
		Vector2(1.07, 1.07),
		0.15
	).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


func _on_button_exit():

	if button_tween and button_tween.is_running():
		button_tween.kill()

	button_tween = create_tween()

	button_tween.tween_property(
		continue_button,
		\"scale\",
		Vector2.ONE,
		0.15
	).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


# ==========================================
# CONTINUE BUTTON ACTION
# ==========================================

func _on_continue_pressed():

	continue_button.disabled = true

	var click_tween = create_tween()

	click_tween.tween_property(
		continue_button,
		\"scale\",
		Vector2(0.93, 0.93),
		0.08
	)

	await click_tween.finished

	# ======================================
	# REPLAY INSTRUCTIONS MODE
	# ======================================

	if is_instruction_replay:

		# Close the popup
		var replay_close_tween = create_tween()
		replay_close_tween.set_parallel(true)

		replay_close_tween.tween_property(
			instruction_panel,
			\"modulate:a\",
			0.0,
			0.25
		)

		replay_close_tween.tween_property(
			instruction_panel,
			\"scale\",
			Vector2(0.9, 0.9),
			0.25
		).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_IN)

		await replay_close_tween.finished

		instruction_panel.visible = false
		title_label.visible = false
		instruction_label.visible = false

		# Restore popup appearance for next time
		instruction_panel.modulate = Color.WHITE
		instruction_panel.scale = Vector2.ONE

		title_label.modulate = Color.WHITE
		instruction_label.modulate = Color.WHITE

		# Remove dim overlay
		var replay_dim_tween = create_tween()

		replay_dim_tween.tween_property(
			dim_overlay,
			\"color:a\",
			0.0,
			0.35
		)

		await replay_dim_tween.finished

		dim_overlay.visible = false
		dim_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

		# Restore Continue button
		continue_button.disabled = false
		continue_button.scale = Vector2.ONE
		continue_button.modulate = Color.WHITE

		# End replay mode
		is_instruction_replay = false

		# Return to gameplay without resetting anything
		game_started = true

		print(\"Returned to gameplay. Puzzle progress preserved!\")

		return


	# ======================================
	# INITIAL INSTRUCTIONS MODE
	# ======================================

	var close_tween = create_tween()
	close_tween.set_parallel(true)

	close_tween.tween_property(
		instruction_panel,
		\"modulate:a\",
		0.0,
		0.25
	)

	close_tween.tween_property(
		instruction_panel,
		\"scale\",
		Vector2(0.9, 0.9),
		0.25
	).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_IN)

	await close_tween.finished

	instruction_panel.visible = false

	# Restore popup appearance
	instruction_panel.modulate = Color.WHITE
	instruction_panel.scale = Vector2.ONE

	var normal_tween = create_tween()

	normal_tween.tween_property(
		dim_overlay,
		\"color:a\",
		0.0,
		0.35
	)

	await normal_tween.finished

	dim_overlay.visible = false
	dim_overlay.mouse_filter = Control.MOUSE_FILTER_IGNORE

	await get_tree().create_timer(0.5).timeout

	# Dim everything again except wooden panel
	dim_overlay.visible = true

	wood_panel.z_index = 11

	var riddle_dim_tween = create_tween()

	riddle_dim_tween.tween_property(
		dim_overlay,
		\"color:a\",
		0.65,
		0.4
	)

	await riddle_dim_tween.finished

	await show_current_riddle()

	start_wood_glow()

	await get_tree().create_timer(4.0).timeout

	var final_tween = create_tween()

	final_tween.tween_property(
		dim_overlay,
		\"color:a\",
		0.0,
		0.4
	)

	await final_tween.finished

	dim_overlay.visible = false

	wood_panel.z_index = 0

	# Show Instructions button when gameplay becomes available
	instruction_button.visible = true
	instruction_button.modulate = Color.WHITE
	instruction_button.scale = Vector2.ONE

	game_started = true

	print(\"Flower puzzle is ready!\")
