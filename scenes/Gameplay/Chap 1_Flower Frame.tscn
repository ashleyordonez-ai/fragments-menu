[node name="InstructionLabel" type="Label" parent="InstructionPanel" unique_id=1621981377]
layout_mode = 0
offset_left = 184.00002
offset_top = 157.0
offset_right = 903.0383
offset_bottom = 532.182
scale = Vector2(1.0402783, 1.0688146)
theme_override_colors/font_color = Color(0.3137255, 0.19607843, 0.15686275, 1)
theme_override_fonts/font = ExtResource("12_3k0p1")
theme_override_font_sizes/font_size = 25
text = "I. Read the Riddle
       Read the clue displayed on the wooden board to identify the correct flower.
II. Drag the Flower
       Find the flower that matches the clue. Drag it from the parchment and drop it  
       onto the correct letter on the left board.
III. Place it Correctly
        If your answer is correct, the flower will stay in place. If not, it will return to 
        its original position.
IV. Complete the Board
        Solve all seven riddles and place every flower to complete the name LEONORE!"
autowrap_mode = 2

