[gd_scene format=3 uid="uid://qvc6gsclhe32"]

[sub_resource type="GDScript" id="GDScript_2k86a"]
script/source = "extends Node2D

signal puzzle_completed

@export var picture: Texture2D
@export var piece_scene: PackedScene
@export var cols := 4
@export var rows := 4
@export var board_max_size := Vector2(560, 560)

@onready var pieces_root = $Pieces
@onready var frame = $Frame
@onready var win_label = $UI/WinLabel

var pieces: Array = []
var placed_count := 0
var board_rect: Rect2
var piece_scale := 1.0

func _ready():
	randomize()
	_build_board()
	_create_pieces()
	await get_tree().create_timer(1.0).timeout  # player sees the whole picture first
	await _shatter()
	for p in pieces:
		p.input_pickable = true

func _build_board():
	var pic_size = picture.get_size()
	piece_scale = min(board_max_size.x / pic_size.x, board_max_size.y / pic_size.y)
	var board_size = pic_size * piece_scale
	var screen = get_viewport_rect().size
	board_rect = Rect2((screen - board_size) / 2.0, board_size)

	var margin := 24.0
	frame.position = board_rect.position - Vector2(margin, margin)
	frame.size = board_size + Vector2(margin * 2, margin * 2)

func _create_pieces():
	var pw = board_rect.size.x / cols
	var ph = board_rect.size.y / rows
	var src_w = picture.get_width() / float(cols)
	var src_h = picture.get_height() / float(rows)

	for y in rows:
		for x in cols:
			var p = piece_scene.instantiate()
			pieces_root.add_child(p)

			var spr: Sprite2D = p.get_node(\"Sprite2D\")
			spr.texture = picture
			spr.region_enabled = true
			spr.region_rect = Rect2(x * src_w, y * src_h, src_w, src_h)
			spr.scale = Vector2(piece_scale, piece_scale)

			var shape = RectangleShape2D.new()
			shape.size = Vector2(pw, ph)
			p.get_node(\"CollisionShape2D\").shape = shape

			# thin outline so pieces look like shards
			var line = Line2D.new()
			line.points = PackedVector2Array([
				Vector2(-pw/2, -ph/2), Vector2(pw/2, -ph/2),
				Vector2(pw/2, ph/2), Vector2(-pw/2, ph/2), Vector2(-pw/2, -ph/2)])
			line.width = 2
			line.default_color = Color(0, 0, 0, 0.5)
			p.add_child(line)

			p.correct_pos = board_rect.position + Vector2((x + 0.5) * pw, (y + 0.5) * ph)
			p.global_position = p.correct_pos
			p.input_pickable = false  # locked until the shatter finishes
			p.placed.connect(_on_piece_placed)
			pieces.append(p)

func _shatter():
	# screen shake
	var shake = create_tween()
	for i in 6:
		shake.tween_property(self, \"position\", Vector2(randf_range(-8, 8), randf_range(-8, 8)), 0.04)
	shake.tween_property(self, \"position\", Vector2.ZERO, 0.04)
	await shake.finished

	# burst apart
	var last_tween: Tween
	for p in pieces:
		p.z_index = 1
		var tw = create_tween().set_parallel(true)
		tw.tween_property(p, \"global_position\", _random_scatter_point(), 0.7) \\
			.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		tw.tween_property(p, \"rotation_degrees\", randf_range(-30, 30), 0.7)
		last_tween = tw
	await last_tween.finished

func _random_scatter_point() -> Vector2:
	var screen = get_viewport_rect().size
	var keep_out = board_rect.grow(40)
	for i in 50:
		var pt = Vector2(randf_range(80, screen.x - 80), randf_range(80, screen.y - 80))
		if not keep_out.has_point(pt):
			return pt
	return Vector2(100, 100)

func _on_piece_placed(_piece):
	placed_count += 1
	if placed_count == pieces.size():
		_on_complete()

func _on_complete():
	var tw = create_tween()
	tw.tween_property(frame, \"modulate\", Color(1, 0.9, 0.5), 0.3)
	tw.tween_property(frame, \"modulate\", Color.WHITE, 0.6)
	win_label.visible = true
	puzzle_completed.emit()  # your story scene can listen to this
"

